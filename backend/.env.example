# Connection string из Neon Console (Dashboard -> Connection Details)
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Один произвольный длинный случайный секрет (например: openssl rand -base64 48)
# Один и тот же на весь проект — он валиден сразу во всех app_N.
JWT_SECRET=

PORT=3000

# Домен задеплоенного фронтенда, напр. https://ваше-имя.netlify.app
# Пусто = разрешены запросы с любого домена (ок для разработки, НЕ для продакшена)
ALLOWED_ORIGIN=

# ИИ-разбор рецептов (бесплатный ключ из Google AI Studio). Без него /ai/recipe отвечает 503
GEMINI_API_KEY=
# Необязательно: модель Gemini (по умолчанию пробуются gemini-3.8-flash и несколько запасных)
GEMINI_MODEL=
# Необязательно: лимит ИИ-запросов на пользователя в час (по умолчанию 20)
AI_HOURLY_LIMIT=20
